<!DOCTYPE html>
<html lang="{{t.lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; base-uri 'none'; form-action 'none'">
  <meta name="generator" content="Proofstack">
  <title>{{name}} · {{headline}}</title>
  <link rel="stylesheet" href="cv.css">
</head>
<body>
<main class="cv">
  <header>
    <h1>{{name}}</h1>
    <p class="headline">{{headline}}</p>
    {{#hasContact}}
    <ul class="contact">
      {{#contact}}<li>{{#linked}}<a href="{{url}}">{{text}}</a>{{/linked}}{{^linked}}{{text}}{{/linked}}</li>{{/contact}}
    </ul>
    {{/hasContact}}
  </header>
  {{#summary}}
  <section>
    <h2>{{t.profile}}</h2>
    <p>{{.}}</p>
  </section>
  {{/summary}}
  {{#hasSkills}}
  <section>
    <h2>{{t.skills}}</h2>
    <ul class="skills">
      {{#skills}}<li><strong>{{area}}:</strong> <span class="chips">{{#items}}<span class="chip">{{.}}</span><span class="sep">, </span>{{/items}}</span></li>{{/skills}}
    </ul>
  </section>
  {{/hasSkills}}
  {{#hasJobs}}
  <section>
    <h2>{{t.experience}}</h2>
    {{#jobs}}
    <article class="entry">
      <div class="entry__head">
        <h3><span class="role">{{role}}</span> <span class="org">· {{company}}</span></h3>
        {{#meta}}<p class="meta">{{.}}</p>{{/meta}}
      </div>
      {{#hasHighlights}}<ul>{{#highlights}}<li>{{.}}</li>{{/highlights}}</ul>{{/hasHighlights}}
      {{#technologies}}<p class="tech"><span class="label">{{t.technologies}}:</span> {{.}}</p>{{/technologies}}
    </article>
    {{/jobs}}
  </section>
  {{/hasJobs}}
  {{#hasProjects}}
  <section>
    <h2>{{t.projects}}</h2>
    {{#projects}}
    <article class="entry">
      <div class="entry__head">
        <h3><span class="role">{{name}}</span></h3>
        {{#hasLink}}<p class="meta"><a href="{{linkUrl}}">{{#linkLabel}}{{.}}{{/linkLabel}}{{^linkLabel}}{{linkUrl}}{{/linkLabel}}</a></p>{{/hasLink}}
      </div>
      <p>{{summary}}</p>
      {{#result}}<p class="result"><span class="label">{{t.result}}:</span> {{.}}</p>{{/result}}
      {{#stack}}<p class="tech"><span class="label">{{t.stack}}:</span> {{.}}</p>{{/stack}}
    </article>
    {{/projects}}
  </section>
  {{/hasProjects}}
  {{#hasStudies}}
  <section>
    <h2>{{t.education}}</h2>
    {{#studies}}
    <article class="entry">
      <div class="entry__head">
        <h3><span class="role">{{title}}</span> <span class="org">· {{institution}}</span></h3>
        {{#meta}}<p class="meta">{{.}}</p>{{/meta}}
      </div>
      {{#hasHighlights}}<ul>{{#highlights}}<li>{{.}}</li>{{/highlights}}</ul>{{/hasHighlights}}
    </article>
    {{/studies}}
  </section>
  {{/hasStudies}}
  {{#hasCertifications}}
  <section>
    <h2>{{t.certifications}}</h2>
    <ul>
      {{#certifications}}<li>{{#linked}}<a href="{{url}}">{{title}}</a>{{/linked}}{{^linked}}{{title}}{{/linked}}{{#detail}} — {{.}}{{/detail}}</li>{{/certifications}}
    </ul>
  </section>
  {{/hasCertifications}}
  {{#hasLanguages}}
  <section>
    <h2>{{t.languages}}</h2>
    <ul class="langs">
      {{#languages}}<li><span class="langs__name">{{name}}</span>{{#hasBar}}<span class="bar bar--{{bar}}" aria-hidden="true"></span>{{/hasBar}}{{#level}}<span class="langs__level">{{.}}</span>{{/level}}</li>{{/languages}}
    </ul>
  </section>
  {{/hasLanguages}}
</main>
</body>
</html>
