<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.proofstack</groupId>
        <artifactId>proofstack-parent</artifactId>
        <version>0.7.0</version>
    </parent>

    <artifactId>proofstack-cli</artifactId>
    <name>Proofstack :: CLI</name>
    <description>Composition root and command line interface.</description>

    <properties>
        <!-- Repository the tests read profiles from; override with -Dproofstack.repoRoot=... to test a fork. -->
        <proofstack.repoRoot>${project.basedir}/..</proofstack.repoRoot>
        <!-- Browser tests: one retry in CI (-De2e.reruns=1), none locally so flakiness is visible. -->
        <e2e.reruns>0</e2e.reruns>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-out-web</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-out-cv</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-in-studio</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-out-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-in-linkedin</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-in-github</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <!-- The schema validator logs through SLF4J; a CLI should not print logger warnings. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Studio in a real browser (docs/specs/proofstack-studio-browser-tests): mvn -Pe2e verify -pl proofstack-cli -am
          Uses the installed Chrome; nothing of this is compiled or downloaded without -Pe2e.
        -->
        <profile>
            <id>e2e</id>
            <dependencies>
                <dependency>
                    <groupId>com.microsoft.playwright</groupId>
                    <artifactId>playwright</artifactId>
                    <version>1.65.1</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>axe-core</artifactId>
                    <version>4.14.0</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.8.0</version>
                        <executions>
                            <execution>
                                <id>e2e-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/e2e/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${maven-surefire-plugin.version}</version>
                        <configuration>
                            <includes>
                                <include>**/*E2E.java</include>
                            </includes>
                            <environmentVariables>
                                <PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>1</PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>
                            </environmentVariables>
                            <systemPropertyVariables>
                                <proofstack.repoRoot>${proofstack.repoRoot}</proofstack.repoRoot>
                            </systemPropertyVariables>
                            <rerunFailingTestsCount>${e2e.reruns}</rerunFailingTestsCount>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <resources>
            <!-- Only the version file is filtered: other resources may contain ${...} on purpose. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>proofstack/cli-version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>proofstack/cli-version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <proofstack.repoRoot>${proofstack.repoRoot}</proofstack.repoRoot>
                        <proofstack.version>${project.version}</proofstack.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>proofstack</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.proofstack.cli.ProofstackCli</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Apache-2.0 §4(d): keep every dependency's NOTICE, not just the last one copied. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/NOTICE</resource>
                                </transformer>
                                <!-- §4(a): the full license text, which a pointer-only LICENSE would otherwise replace. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/LICENSE</resource>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
