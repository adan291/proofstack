<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.proofstack</groupId>
        <artifactId>proofstack-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>proofstack-cli</artifactId>
    <name>Proofstack :: CLI</name>
    <description>Composition root and command line interface.</description>

    <dependencies>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-in-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-out-web</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-out-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-in-linkedin</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-out-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.proofstack</groupId>
            <artifactId>proofstack-in-github</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <!-- The schema validator logs through SLF4J; a CLI should not print logger warnings. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <proofstack.repoRoot>${project.basedir}/..</proofstack.repoRoot>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>proofstack</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.proofstack.cli.ProofstackCli</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
