{
  "mcpServers": {
    "proofstack": {
      "command": "java",
      "args": ["-jar", "/path/to/proofstack-mcp-server.jar"],
      "env": {
        "PROOFSTACK_PROFILE": "/path/to/proofstack/profiles/you/profile.yaml"
      },
      "disabled": false,
      "autoApprove": ["get_profile_summary", "list_projects", "get_project", "search_portfolio", "get_content_facts"]
    }
  }
}
